{
  "version": 1,
  "name": "assert a live Windows edit control's observed value",
  "platforms": ["windows"],
  "vars": {},
  "defaultTimeoutMs": 20000,
  "steps": [
    { "type": "cuse", "action": "element", "args": ["notepad-target"], "options": { "role": "text" }, "saveAs": "target" },
    { "type": "assert", "actual": "${steps.target.data.value}", "operator": "contains", "expected": "cuse typed into the classic notepad" }
  ]
}
